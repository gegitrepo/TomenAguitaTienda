<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium">

        <TextView
            android:id="@+id/tvBienvenido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/title_dashboard"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Fila 1 de métricas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsuarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_small"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/primary"
            app:layout_constraintEnd_toStartOf="@id/cardProductos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBienvenido">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_medium">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_total_users" android:textColor="@color/on_primary_dim" android:textSize="@dimen/text_body" />
                <TextView android:id="@+id/tvTotalUsuarios" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" android:textSize="@dimen/text_card_metric" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProductos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginStart="@dimen/margin_small"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardUsuarios"
            app:layout_constraintTop_toBottomOf="@id/tvBienvenido">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_medium">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_total_products" android:textColor="@color/on_primary_dim" android:textSize="@dimen/text_body" />
                <TextView android:id="@+id/tvTotalProductos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" android:textSize="@dimen/text_card_metric" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fila 2 de métricas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPedidos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_small"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/accent"
            app:layout_constraintEnd_toStartOf="@id/cardVentas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardUsuarios">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_medium">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_total_orders" android:textColor="@color/on_primary_dim" android:textSize="@dimen/text_body" />
                <TextView android:id="@+id/tvTotalPedidos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" android:textSize="@dimen/text_card_metric" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVentas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginStart="@dimen/margin_small"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/success"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardPedidos"
            app:layout_constraintTop_toBottomOf="@id/cardProductos">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_medium">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_total_sales" android:textColor="@color/on_primary_dim" android:textSize="@dimen/text_body" />
                <TextView android:id="@+id/tvTotalVentas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/on_primary" android:textSize="@dimen/text_card_metric_large" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fila 3: Pedidos pendientes + Pedidos cancelados -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_small"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/warning"
            app:layout_constraintEnd_toStartOf="@id/cardCanceladas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPedidos">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_medium">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_pending_metric" android:textColor="@color/on_primary_dim" android:textSize="@dimen/text_body" />
                <TextView android:id="@+id/tvPedidosPendientes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/on_primary" android:textSize="@dimen/text_card_metric" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCanceladas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginStart="@dimen/margin_small"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/error"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardPendientes"
            app:layout_constraintTop_toBottomOf="@id/cardVentas">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/padding_medium">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_cancelled_metric" android:textColor="@color/on_primary_dim" android:textSize="@dimen/text_body" />
                <TextView android:id="@+id/tvPedidosCancelados" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/on_primary" android:textSize="@dimen/text_card_metric" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accesos rápidos -->
        <TextView
            android:id="@+id/tvAccesosLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/label_quick_access"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPendientes" />

        <LinearLayout
            android:id="@+id/llAccesos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_large"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAccesosLabel">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGestionUsuarios"
                style="@style/Widget.TomenAguita.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/title_users" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGestionProductos"
                style="@style/Widget.TomenAguita.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/title_products" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
